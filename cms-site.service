[Unit]
Description=CMS VLESS-Keenetic (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/cms-site
Environment="PATH=/opt/cms-site/venv/bin:/usr/bin"
EnvironmentFile=/opt/cms-site/.env
ExecStart=/opt/cms-site/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
