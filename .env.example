# CMS Keenetic — переменные окружения
# Скопируйте этот файл в .env и заполните значения

# Секретный ключ Flask (сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-generate-your-own

# База данных
DATABASE_URL=sqlite:///cms.db

# Telegram Bot
BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=keen_zip_bot

# Админ-панель
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Сайт
SITE_URL=https://keen.z-ip.pro
SITE_NAME=Настройка Keenetic VLESS Reality

# Яндекс (необязательно)
YANDEX_METRIKA_ID=
YANDEX_WEBMASTER=

# IndexNow (ускоренная индексация Яндекс/Bing)
# Ключ генерируется автоматически. При необходимости задайте свой (32 hex-символа):
# python3 -c "import secrets; print(secrets.token_hex(16))"
INDEXNOW_KEY=

# Google reCAPTCHA v3 для админ-панели (необязательно)
# Получить ключи: https://www.google.com/recaptcha/admin/create
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
